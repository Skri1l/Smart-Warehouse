    "test": "vitest run",
    "test:watch": "vitest",
    "licenses": "license-checker --production --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD\" --excludePrivatePackages"
  },
  "msw": {
